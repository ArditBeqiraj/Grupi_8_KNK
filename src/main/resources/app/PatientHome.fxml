<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="600.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PacientHomeController">
    <children>
        <AnchorPane fx:id="main_form">
            <children>
                <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <top>
                        <AnchorPane prefHeight="100.0" BorderPane.alignment="CENTER">
                            <children>
                                <FontAwesomeIconView glyphName="USER_MD" layoutX="57.0" layoutY="41.0" scaleX="4.0" scaleY="4.0" />
                                <Label layoutX="133.0" layoutY="26.0" text="%patient.panel">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </top>
                    <left>
                        <AnchorPane prefWidth="211.0">
                            <children>
                                <AnchorPane styleClass="nav-form" stylesheets="@../css/pacient_homepage.css">
                                    <children>
                                        <Label layoutX="35.0" layoutY="114.0" text="%welcome" textFill="WHITE">
                                            <font><Font size="20.0" /></font>
                                        </Label>
                                        <FontAwesomeIconView fill="#fff" glyphName="USER" layoutX="103.0" layoutY="64.0" scaleX="8.0" scaleY="8.0" />
                                        <Line endX="100.0" layoutX="111.0" layoutY="152.0" startX="-100.0" stroke="WHITE" />
                                        <Button fx:id="myProfile_btn" layoutX="11.0" layoutY="410.0" onAction="#switchform"
                                                prefHeight="51.0" prefWidth="196.0" styleClass="nav-butoni"
                                                stylesheets="@../css/pacient_homepage.css" text="%my.profile">
                                            <graphic>
                                                <FontAwesomeIconView fill="WHITE" glyphName="ID_CARD" size="1.5em"/>
                                            </graphic>
                                        </Button>

                                        <Button fx:id="home_btn" layoutX="11.0" layoutY="166.0" onAction="#switchform" prefHeight="51.0" prefWidth="196.0" styleClass="nav-butoni" stylesheets="@../css/pacient_homepage.css" text="%home">
                                            <graphic><FontAwesomeIconView fill="WHITE" glyphName="HOME" size="1.5em" /></graphic>
                                        </Button>

                                        <Button fx:id="zgjedhMjekun_btn" layoutX="11.0" layoutY="227.0" onAction="#switchform" prefHeight="51.0" prefWidth="196.0" styleClass="nav-butoni" stylesheets="@../css/pacient_homepage.css" text="%choose.doctor">
                                            <graphic><FontAwesomeIconView fill="WHITE" glyphName="STETHOSCOPE" size="1.5em" /></graphic>
                                        </Button>

                                        <Button fx:id="rezervoTermin_btn" layoutX="11.0" layoutY="288.0" onAction="#switchform" prefHeight="51.0" prefWidth="196.0" styleClass="nav-butoni" stylesheets="@../css/pacient_homepage.css" text="%schedule.appointment">
                                            <graphic><FontAwesomeIconView fill="WHITE" glyphName="CALENDAR_PLUS_O" size="1.5em" /></graphic>
                                        </Button>

                                        <Button fx:id="anuloTermin_btn" layoutX="11.0" layoutY="349.0" onAction="#switchform" prefHeight="51.0" prefWidth="196.0" styleClass="nav-butoni" stylesheets="@../css/pacient_homepage.css" text="%cancel.appointment">
                                            <graphic><FontAwesomeIconView fill="WHITE" glyphName="CALENDAR_TIMES_O" size="1.5em" /></graphic>
                                        </Button>

                                        <Button fx:id="shkyqu" layoutX="25.0" layoutY="463.0" onAction="#shkyqu" stylesheets="@../css/pacient_homepage.css" textFill="WHITE">
                                            <graphic><FontAwesomeIconView fill="WHITE" glyphName="SIGN_OUT" size="1.7em" wrappingWidth="18.942855834960938" /></graphic>
                                            <styleClass>
                                                <String fx:value="shkyqu" />
                                                <String fx:value="shadow" />
                                            </styleClass>
                                        </Button>
                                        <Label layoutX="67.0" layoutY="466.0" text="%logout" textFill="WHITE">
                                            <font><Font size="16.0" /></font>
                                        </Label>
                                    </children>
                                </AnchorPane>
                            </children>
                        </AnchorPane>
                    </left>
                    <center>
                        <AnchorPane>
                            <children>
                                <AnchorPane fx:id="home_form" styleClass="white-background shadow" stylesheets="@../css/pacient_homepage.css" visible="true">
                                    <children>
                                        <Label layoutX="40.0" layoutY="20.0" text="%your.appointments:" />

                                        <TableView fx:id="tabelaTerminet" layoutX="40.0" layoutY="50.0" prefWidth="700.0" prefHeight="400.0">
                                            <columns>
                                                <TableColumn fx:id="colMjeku" text="%doctor" prefWidth="200.0" />
                                                <TableColumn fx:id="colData" text="%date" prefWidth="150.0" />
                                                <TableColumn fx:id="colStatusi" text="%status" prefWidth="150.0" />
                                                <TableColumn fx:id="colShenime" text="%notes" prefWidth="200.0" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </AnchorPane>

                                <AnchorPane fx:id="zgjedhMjekun_form" styleClass="white-background shadow" stylesheets="@../css/pacient_homepage.css" visible="false">
                                    <children>
                                        <Button text="%save_doctor" layoutX="300.0" layoutY="20.0" prefWidth="180.0" onAction="#ruajMjekunFamiljar"/>
                                        <TableView fx:id="tabelaMjekeve" layoutX="48.0" layoutY="60.0" prefHeight="443.0" prefWidth="729.0">
                                            <columns>
                                                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                                <TableColumn fx:id="colEmri" prefWidth="150.0" text="%name" />
                                                <TableColumn fx:id="colMbiemri" prefWidth="150.0" text="%surname" />
                                                <TableColumn fx:id="colSpecializimi" prefWidth="300.0" text="%specialization" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </AnchorPane>

                                <AnchorPane fx:id="rezervoTermin_form" styleClass="white-background shadow" stylesheets="@../css/pacient_homepage.css" visible="false">
                                    <children>
                                        <Label layoutX="40" layoutY="20" text="%schedule.appointment" />

                                        <Label layoutX="40" layoutY="60" text="%choose.doctor:" />
                                        <ComboBox fx:id="comboMjeku" layoutX="150" layoutY="55" prefWidth="300"/>

                                        <Label layoutX="40" layoutY="100" text="%date:" />
                                        <DatePicker fx:id="datePicker" layoutX="150" layoutY="95"/>

                                        <Label layoutX="40" layoutY="140" text="%notes:" />
                                        <TextArea fx:id="textShenime" layoutX="150" layoutY="135" prefHeight="100" prefWidth="300"/>

                                        <Button text="%schedule" layoutX="150" layoutY="250" onAction="#rezervoTermin"/>
                                    </children>
                                </AnchorPane>

                                <AnchorPane fx:id="anuloTermin_form" styleClass="white-background shadow" stylesheets="@../css/pacient_homepage.css" visible="false" >
                                    <children>
                                        <Label layoutX="40" layoutY="20" text="%cancel.appointment" />

                                        <TableView fx:id="tabelaAnuloTerminet" layoutX="40" layoutY="50" prefHeight="300" prefWidth="600">
                                            <columns>
                                                <TableColumn fx:id="colMjekuAnulo" text="%doctor" prefWidth="200"/>
                                                <TableColumn fx:id="colDataAnulo" text="%date" prefWidth="150"/>
                                                <TableColumn fx:id="colStatusiAnulo" text="%status" prefWidth="150"/>
                                            </columns>
                                        </TableView>

                                        <Button text="%cancel.appointment" layoutX="40" layoutY="370" onAction="#anuloTermin"/>
                                    </children>
                                </AnchorPane>
                                <AnchorPane fx:id="myProfile_form" styleClass="white-background shadow"
                                            stylesheets="@../css/pacient_homepage.css" visible="false">
                                    <children>
                                        <Label layoutX="40" layoutY="20" text="%patient.profile" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                                        <Label layoutX="40" layoutY="60" text="%name:" />
                                        <Label fx:id="lblEmri" layoutX="150" layoutY="60"/>

                                        <Label layoutX="40" layoutY="90" text="%surname:" />
                                        <Label fx:id="lblMbiemri" layoutX="150" layoutY="90"/>

                                        <Label layoutX="40" layoutY="120" text="%email:" />
                                        <Label fx:id="lblEmail" layoutX="150" layoutY="120"/>

                                        <Label layoutX="40" layoutY="150" text="%phone:" />
                                        <Label fx:id="lblTelefoni" layoutX="150" layoutY="150"/>

                                        <Label layoutX="40" layoutY="180" text="%family.doctor:" />
                                        <Label fx:id="lblMjekuFamiljar" layoutX="150" layoutY="180" />
                                    </children>
                                </AnchorPane>

                            </children>
                        </AnchorPane>
                    </center>
                </BorderPane>
            </children>
        </AnchorPane>
    </children>
</StackPane>
