                        </TableView>
                    </children>
                </AnchorPane>
                <TextField fx:id="filterField" layoutX="180.0" layoutY="25.0" promptText="%filter" AnchorPane.leftAnchor="180.0" AnchorPane.rightAnchor="700.0" />
            </children>
        </AnchorPane>
    </children>
</StackPane>