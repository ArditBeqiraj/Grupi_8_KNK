<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane prefHeight="400.0" prefWidth="1100.0" stylesheets="@../css/admin_homepage.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DoctorAppointmentsController">
    <children>
        <AnchorPane maxHeight="600.0" maxWidth="1100.0" prefHeight="600.0" prefWidth="1100.0" style="-fx-background-color: #D1D9E6;">
            <children>
                <fx:include source="DoctorSidebar.fxml" />
                <AnchorPane layoutX="220.0" layoutY="75.0" prefHeight="496.0" prefWidth="734.0" style="-fx-background-color: #3E8E7E;" AnchorPane.bottomAnchor="75.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="75.0">
                    <children>
                        <TableView fx:id="tableTerminet" prefHeight="496.0" prefWidth="734.0" style="-fx-background-color: #e9ebee;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <columns>
                                <TableColumn fx:id="colEmri" prefWidth="100.0" text="%name" />
                                <TableColumn fx:id="colMbiemri" prefWidth="100.0" text="%surname" />
                                <TableColumn fx:id="colData" prefWidth="120.0" text="%date" />
                                <TableColumn fx:id="colStatusi" prefWidth="100.0" text="%status" />
                                <TableColumn fx:id="colShenime" prefWidth="214.0" text="%notes" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </AnchorPane>
                <TextField fx:id="filterField" layoutX="220.0" layoutY="25.0" promptText="%filter" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="660.0" />
            </children>
        </AnchorPane>
    </children>
</StackPane>
